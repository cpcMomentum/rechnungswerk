{
  "name": "rechnungswerk",
  "version": "0.1.5",
  "description": "Rechnungen und E-Rechnungen schreiben mit automatischer DATEV-Übergabe",
  "license": "AGPL-3.0-or-later",
  "author": "cpcMomentum",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/cpcMomentum/rechnungswerk.git"
  },
  "bugs": {
    "url": "https://github.com/cpcMomentum/rechnungswerk/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && mkdir -p js css && cp -r dist/js/* js/ && cp -r dist/css/* css/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "l10n:check": "nc-l10n-check",
    "l10n:fix": "nc-l10n-check --fix",
    "lint:fix": "eslint src --fix",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.5.2",
    "@nextcloud/dialogs": "^7.4.1",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.5.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.13",
    "vue-material-design-icons": "^5.3.1",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nextcloud/eslint-config": "^9.0.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "happy-dom": "^20.9.0",
    "nc-app-tooling": "github:cpcMomentum/nc-app-tooling#v1.9.0",
    "sass": "^1.70.0",
    "typescript": "^5.7.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  }
}
